# LLM provider: "anthropic" (hosted) or "ollama" (local/offline)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (offline mode). Run: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Multilingual embedding model (works for English, Tamil, Hindi)
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# Cosine similarity below which we answer "not found in your documents"
MIN_SIMILARITY=0.35

CHROMA_DIR=data/chroma

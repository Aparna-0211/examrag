# LLM provider: "groq" (hosted, free tier), "anthropic" (hosted, paid) or "ollama" (local/offline)
LLM_PROVIDER=groq

# Groq: create a key at console.groq.com. Model names change over time, so
# if you get a "could not use model" error, pick another from your Groq model list.
GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (offline mode). Run: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Multilingual embedding model (works for English, Tamil, Hindi).
# BAAI/bge-m3 retrieves better but is large; the MiniLM model below is smaller and faster to download.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# Cosine similarity below which we answer "not found in your documents"
MIN_SIMILARITY=0.35

CHROMA_DIR=data/chromas